  "terminalLinks.matchers": [
    // ============================================================================
    // Terminal Link Resolution Strategy: Path Aliasing vs. Workspace Root Resolution
    // ============================================================================
    //
    // ISSUE:
    // Cargo's CLI diagnostic output prints relative file paths (e.g.,
    // "crates/learn/src/daemon/daemon.rs:132:1") prefixed with artifacts like "--> "
    // or whitespace. VS Code's native terminal link detector fails to robustly resolve
    // these against active workspace contexts, throwing them into a dead-end Quick Pick menu.
    //
    // WHY `${workspaceFolder}` FAILS HERE:
    // Standard workspace variables evaluate dynamically, but extension-level matchers
    // often resolve `${workspaceFolder}` based on the terminal's active child process
    // working directory rather than the absolute root workspace manifest. If Cargo executes
    // from a nested member or sub-crate context, the relative path compounds or desyncs,
    // resulting in broken or duplicated paths.
    //
    // SOLUTION & SPEC:
    // Using explicit absolute estate mapping (`${userHome}/KB/...`) anchors the target
    // deterministically to your estate layout regardless of shell cwd shifts.
    //
    // SPECIFICATION REFERENCE:
    // This relies on ANSI escape sequence and URI hyperlink formatting standards
    // (specifically OSC 8 -- Operating System Commands for hyperlinks, combined with
    // standard compiler diagnostic message formatting specs defined in IDE integration protocols).
    // ============================================================================
    // Two conflicting formatters for fixing VSCode cmd+click in terminal
    // 1. Ownership CLI/Process output
    // "terminalLinks.matchers": [
    // {
    // 	"regex": "(?:[:\\s]+)([a-zA-Z0-9_\\-./]+\\.rs):(\\d+):(\\d+)",
    // 	"uri": "vscode://file${userHome}/KB/project/app/loi/$1:$2:$3"
    // }
    // ],
    // 2. Rust formatter
  ],
