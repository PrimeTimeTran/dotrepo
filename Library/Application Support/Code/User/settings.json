  //   {
  //     "regex": "(?:[:\\s]+)([a-zA-Z0-9_\\-./]+\\.rs):(\\d+):(\\d+)",
  //     "uri": "vscode://file${workspaceFolder}/$1:$2:$3",
  //   },
  // ],
